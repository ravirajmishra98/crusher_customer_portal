      },
      "customerId": {
        "type": "integer",
        "format": "int32"
      },
      "customerName": {
        "type": "string"
      },
      "customerAddress": {
        "type": "string"
      },
      "customerGstNo": {
        "type": "string"
      },
      "companyId": {
        "type": "integer",
        "format": "int32"
      },
      "companyName": {
        "type": "string"
      },
      "companyAddress": {
        "type": "string"
      },
      "companyGstNo": {
        "type": "string"
      },
      "einvoicingRequired": {
        "type": "boolean"
      },
      "invoiceDate": {
        "type": "string",
        "format": "date"
      },
      "billingPeriodFrom": {
        "type": "string",
        "format": "date"
      },
      "billingPeriodTo": {
        "type": "string",
        "format": "date"
      },
      "totalNetWt": {
        "type": "number"
      },
      "subtotal": {
        "type": "number"
      },
      "gstAmt": {
        "type": "number"
      },
      "totalAmt": {
        "type": "number"
      },
      "notes": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "DRAFT",
          "CONFIRMED",
          "CANCELLED"
        ]
      },
      "documentType": {
        "type": "string",
        "enum": [
          "combined",
          "material",
          "transport"
        ]
      },
      "billingGroupId": {
        "type": "string",
        "description": "UUID grouping separate material+transport invoices"
      },
      "linkedInvoiceId": {
