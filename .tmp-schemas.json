        "items": {
          "$ref": "#/components/schemas/InvoiceDetailAllOfItems"
        }
      }
    }
  },
  "PortalWeighmentSummary": {
    "type": "object",
    "description": "Customer-visible trip summary. Internal fields (overrideBy, traderCompanyId, billingCompanyId, legOrder, chainLength) are omitted.",
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32"
      },
      "challanNo": {
        "type": "string"
      },
      "vehicleNo": {
        "type": "string"
      },
      "materialName": {
        "type": "string"
      },
      "companyName": {
        "type": "string"
      },
      "netWt": {
        "type": "number",
        "description": "MT"
      },
      "rate": {
        "type": "number",
        "description": "₹/MT"
      },
      "amount": {
        "type": "number"
      },
      "totalAmt": {
        "type": "number"
      },
      "status": {
        "type": "string",
        "enum": [
          "PENDING_APPROVAL",
          "PENDING_LOAD",
          "PENDING_GROSS",
          "COMPLETED",
          "CANCELLED_NO_LOAD",
          "CANCELLED_CREDIT_REJECTED"
        ]
      },
      "tareTime": {
        "type": "string",
        "format": "date-time"
      },
      "grossTime": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "PortalLoginResponse": {
    "type": "object",
    "properties": {
      "token": {
        "type": "string"
      },
      "expiresIn": {
        "type": "integer",
        "format": "int32",
        "description": "Access token TTL in seconds"
      },
      "customerId": {
        "type": "integer",
        "format": "int32"
      },
      "customerName": {
        "type": "string"
      },
      "refreshToken": {
        "type": "string",
        "description": "Use at POST /portal/refresh to get a new access token without re-login"
      },
      "mustChangePassword": {
        "type": "boolean",
        "description": "True when logged in with an admin-issued one-time password — force a reset via POST /portal/change-password"
      }
    }
  },
  "PortalChangePasswordRequest": {
    "type": "object",
    "properties": {
      "currentPassword": {
        "type": "string"
      },
      "newPassword": {
        "type": "string",
        "maxLength": 2147483647,
        "minLength": 8
      }
    },
    "required": [
      "currentPassword",
      "newPassword"
    ]
  },
  "PortalRefreshRequest": {
    "type": "object",
    "properties": {
      "refreshToken": {
        "type": "string"
      }
    },
    "required": [
      "refreshToken"
    ]
  },
  "_portal_login_post_request": {
    "type": "object",
    "description": "Provide either email (the portal email set via PATCH /customers/{id}/portal-access) or code (customer code). At least one is required.",
    "properties": {
      "email": {
        "type": "string",
        "description": "Portal email set via PATCH /customers/{id}/portal-access"
      },
      "code": {
        "type": "string",
        "description": "Customer code (e.g. CUST001) — alternative to email"
      },
      "password": {
        "type": "string"
      }
    },
    "required": [
      "password"
    ]
  }
}