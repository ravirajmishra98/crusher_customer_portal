{
  "PortalProfile": {
    "type": "object",
    "description": "Customer-visible profile (read-only). Internal flags are omitted.",
    "properties": {
      "customerId": {
        "type": "integer",
        "format": "int32"
      },
      "name": {
        "type": "string"
      },
      "code": {
        "type": "string"
      },
      "gstNo": {
        "type": "string"
      },
      "phone": {
        "type": "string"
      },
      "address": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "creditLimit": {
        "type": "number"
      },
      "status": {
        "type": "string"
      }
    }
  },
  "PortalDashboard": {
    "type": "object",
    "description": "Customer self-service landing data. Only the authenticated customer's own data; internal fields omitted.",
    "properties": {
      "profile": {
        "$ref": "#/components/schemas/PortalProfile"
      },
      "creditStatus": {
        "$ref": "#/components/schemas/CreditStatus"
      },
      "outstanding": {
        "type": "number"
      },
      "aging": {
        "$ref": "#/components/schemas/PortalAging"
      },
      "totalDispatches": {
        "type": "integer",
        "format": "int32"
      },
      "openInvoices": {
        "type": "integer",
        "format": "int32"
      },
      "recentDispatches": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/PortalWeighmentSummary"
        }
      },
      "recentInvoices": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Invoice"
        }
      }
    }
  },
  "CreditStatus": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "WARNING ≥ warningPct (info); SOFT_BLOCK ≥ softblockPct (operator must acknowledge); HARD_BLOCK ≥ 100% or manually blocked (admin override / approval required)",
        "enum": [
          "OK",
          "WARNING",
          "SOFT_BLOCK",
          "HARD_BLOCK"
        ]
      },
      "outstanding": {
        "type": "number"
      },
      "creditLimit": {
        "type": "number"
      },
      "usedPct": {
        "type": "number"
      },
      "openTrips": {
        "type": "integer",
        "format": "int32",
        "description": "In-flight (unbilled) weighments for this customer — a soft exposure signal; not counted in the block decision"
      }
    }
  },
  "PortalOutstanding": {
    "type": "object",
    "properties": {
      "outstanding": {
        "type": "number",
        "description": "Receivable balance (₹)"
      },
      "creditLimit": {
        "type": "number"
      },
      "available": {
        "type": "number",
        "description": "creditLimit − outstanding (null if no limit)"
      },
      "aging": {
        "$ref": "#/components/schemas/PortalAging"
      }
    }
  },
  "LedgerResponse": {
    "type": "object",
    "properties": {
      "view": {
        "type": "string",
        "enum": [
          "dispatch",
          "invoice"
        ]
      },
      "openingBalance": {
        "type": "number"
      },
      "closingBalance": {
        "type": "number"
      },
      "entries": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/LedgerResponseEntriesInner"
        }
      }
    }
  },
  "Invoice": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "format": "int32"
      },
      "invoiceNo": {
        "type": "string"
      },
      "customerId": {
        "type": "integer",
        "format": "int32"
      },
      "customerName": {
        "type": "string"
      },
      "customerAddress": {
        "type": "string"
      },
      "customerGstNo": {
        "type": "string"
      },
      "companyId": {
        "type": "integer",
        "format": "int32"
      },
      "companyName": {
        "type": "string"
      },
      "companyAddress": {
        "type": "string"
      },
      "companyGstNo": {
        "type": "string"
      },
      "einvoicingRequired": {
        "type": "boolean"
      },
      "invoiceDate": {
        "type": "string",
        "format": "date"
      },
      "billingPeriodFrom": {
        "type": "string",
        "format": "date"
      },
      "billingPeriodTo": {
        "type": "string",
        "format": "date"
      },
      "totalNetWt": {
        "type": "number"
      },
      "subtotal": {
        "type": "number"
      },
      "gstAmt": {
        "type": "number"
      },
      "totalAmt": {
        "type": "number"
      },
      "notes": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "DRAFT",
          "CONFIRMED",
          "CANCELLED"
        ]
      },
      "documentType": {
        "type": "string",
        "enum": [
          "combined",
          "material",
          "transport"
        ]
      },
      "billingGroupId": {
        "type": "string",
        "description": "UUID grouping separate material+transport invoices"
      },
      "linkedInvoiceId": {
        "type": "integer",
        "format": "int32"
      },
      "irn": {
        "type": "string"
      },
      "ackNo": {
        "type": "string"
      },
      "ackDate": {
        "type": "string"
      },
      "qrCode": {
        "type": "string"
      },
      "einvoiceStatus": {
        "type": "string"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "createdBy": {
        "type": "integer",
        "format": "int32"
      },
      "createdByName": {
        "type": "string"
      },
      "createdByRole": {
        "type": "string"
      },
      "updatedByName": {
        "type": "string"
      },
      "updatedByRole": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "InvoiceDetail": {
    "type": "object",
